# 生成前设计对话（Pi）。默认关闭；Docker 镜像不含 Pi，保持关闭。
DESIGN_CHAT_ENABLED=false
DESIGN_CHAT_PI_COMMAND=pi
DESIGN_CHAT_PI_PROVIDER=magpie
DESIGN_CHAT_PI_MODEL=
DESIGN_CHAT_PI_THINKING=
DESIGN_CHAT_PI_MODELS_FILE=
