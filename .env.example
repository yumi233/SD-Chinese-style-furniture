DESIGN_CHAT_PER_MINUTE=6
DESIGN_CHAT_MAX_MESSAGES=20
# 免登录试用（/studio?guest=1）：只能聊天，不能生成；数据独立、按浏览器会话区分、到期清理。
DESIGN_CHAT_GUEST_ENABLED=false
DESIGN_CHAT_GUEST_DATA_DIR=
DESIGN_CHAT_GUEST_PER_MINUTE=2
DESIGN_CHAT_GUEST_MAX_MESSAGES=6
DESIGN_CHAT_GUEST_GLOBAL_PER_MINUTE=20
DESIGN_CHAT_GUEST_TTL_HOURS=24
# 访客真实生成（同一 /studio?guest=1）：走原有生成任务链路，只算成功保存的图片。
GUEST_GENERATION_ENABLED=false
GUEST_GENERATION_PER_SESSION=1
GUEST_GENERATION_PER_DAY=10
GUEST_GENERATION_TTL_HOURS=24
